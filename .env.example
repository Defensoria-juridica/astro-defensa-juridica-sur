# URL del proyecto: Configuración > API en Supabase
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave secreta de servicio. Nunca usar una clave pública o exponerla con PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role

# Acceso privado al panel /admin/login
ADMIN_PASSWORD=elige_una_contrasena_larga_y_unica

# Cadena aleatoria de al menos 32 caracteres para firmar sesiones
ADMIN_SESSION_SECRET=genera_una_cadena_aleatoria_de_64_caracteres
