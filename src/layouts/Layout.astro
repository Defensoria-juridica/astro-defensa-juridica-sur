---
import "../styles/global.css";
import "aos/dist/aos.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";

interface Props {
    title?: string;
    description?: string;
    canonicalPath?: string;
    ogType?: "website" | "article";
    noindex?: boolean;
    structuredData?: Record<string, unknown>;
}

const defaultTitle = "Defensa Jurídica Sur | Abogados en Puerto Montt";
const defaultDescription =
    "Estudio jurídico en Puerto Montt con abogados especializados en Derecho Penal, Familia, Civil, Laboral, Administrativo y Justicia Militar.";
const {
    title = defaultTitle,
    description = defaultDescription,
    canonicalPath = Astro.url.pathname,
    ogType = "website",
    noindex = false,
    structuredData,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://defensajuridicasur.cl/");
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const organizationSchema = {
    "@context": "https://schema.org",
    "@type": "LegalService",
    "@id": "https://defensajuridicasur.cl/#organization",
    name: "Defensa Jurídica Sur",
    alternateName: "Uribe y Fitzgerald y Cia.",
    url: "https://defensajuridicasur.cl/",
    logo: "https://defensajuridicasur.cl/favicon.svg",
    description: defaultDescription,
    image: "https://defensajuridicasur.cl/assets/og-image.jpg",
    telephone: ["+56958835620", "+56921614436"],
    email: "contacto@defensajuridicasur.cl",
    priceRange: "$$",
    address: {
        "@type": "PostalAddress",
        streetAddress: "O'Higgins 167, Edificio Plaza, Oficina 706",
        addressLocality: "Puerto Montt",
        addressRegion: "Los Lagos",
        postalCode: "5480000",
        addressCountry: "CL",
    },
    geo: {
        "@type": "GeoCoordinates",
        latitude: -41.4714627,
        longitude: -72.9392936,
    },
    openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        opens: "09:00",
        closes: "18:00",
    },
    areaServed: [
        { "@type": "City", name: "Puerto Montt" },
        { "@type": "AdministrativeArea", name: "Región de Los Lagos" },
    ],
    knowsAbout: [
        "Derecho Penal",
        "Derecho Civil",
        "Derecho de Familia",
        "Derecho Laboral",
        "Derecho Administrativo",
        "Justicia Militar",
        "Policía Local",
    ],
    sameAs: ["https://instagram.com/defensajuridicasur"],
};
---

<!doctype html>
<html lang="es" class="scroll-smooth overflow-x-hidden">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- Preconnect for performance -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <!-- Favicon - Múltiples formatos para compatibilidad -->
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/favicon.png" />
        <meta name="generator" content={Astro.generator} />

        <!-- SEO Meta Tags -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Crow Advance" />
        <meta
            name="robots"
            content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"}
        />
        <meta name="language" content="Spanish" />

        <!-- Geo Meta Tags -->
        <meta name="geo.region" content="CL-LL" />
        <meta name="geo.placename" content="Puerto Montt" />
        <meta name="geo.position" content="-41.4693;-72.9424" />
        <meta name="ICBM" content="-41.4693, -72.9424" />

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalUrl} />

        <!-- Hreflang -->
        <link rel="alternate" hreflang="es-cl" href={canonicalUrl} />
        <link rel="alternate" hreflang="es" href={canonicalUrl} />
        <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

        <!-- Open Graph Meta Tags -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:site_name" content="Defensa Jurídica Sur" />
        <meta property="og:image" content="https://defensajuridicasur.cl/assets/og-image.jpg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content="Defensa Jurídica Sur - Abogados especialistas en Puerto Montt"
        />
        <meta property="og:locale" content="es_CL" />

        <!-- Twitter Card Meta Tags -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta
            name="twitter:image"
            content="https://defensajuridicasur.cl/assets/twitter-card.jpg"
        />
        <meta
            name="twitter:image:alt"
            content="Defensa Jurídica Sur - Abogados especialistas en Puerto Montt"
        />
        <meta name="twitter:site" content="@defensajuridicasur" />
        <meta name="twitter:creator" content="@defensajuridicasur" />

        <!-- Theme Color for PWA -->
        <meta name="theme-color" content="#c18f59" />
        <meta name="msapplication-TileColor" content="#c18f59" />

        <!-- Additional Performance -->
        <meta name="format-detection" content="telephone=no" />
        <meta http-equiv="x-ua-compatible" content="ie=edge" />

        <!-- Structured Data - Schema.org -->
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(organizationSchema)}
        />
        {
            structuredData && (
                <script
                    type="application/ld+json"
                    is:inline
                    set:html={JSON.stringify(structuredData)}
                />
            )
        }

        <GoogleAnalytics />
    </head>
    <body class="overflow-x-hidden">
        <Header />
        <slot />
        <Footer />

        <!-- Inicialización de AOS -->
        <script>
            import AOS from "aos";

            // Inicializar AOS cuando el DOM esté listo
            AOS.init({
                duration: 1000,
                easing: "ease-in-out",
                once: true,
                offset: 100,
                delay: 0,
                disable: false,
            });
        </script>
    </body>
</html>
