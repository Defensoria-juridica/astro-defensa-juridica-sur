---
import { adminConfigurado, obtenerAdmin } from "../../lib/admin-auth";

const admin = await obtenerAdmin(Astro.cookies);
if (admin) {
  return Astro.redirect(admin.app_metadata.force_password_change ? '/admin/cuenta' : '/admin/consultas');
}

const error = Astro.url.searchParams.get("error");
---

<!doctype html>
<html lang="es" class="admin-login-page">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Administración | Defensa Jurídica Sur</title>
    <style>
      .admin-login-page { font-family: Arial, sans-serif; color: #212529; background: #f4f5f6; }
      .admin-login-page body { min-height: 100vh; margin: 0; display: grid; place-items: center; }
      .admin-login-page main { width: min(420px, calc(100% - 40px)); background: white; padding: 36px; border-radius: 18px; box-shadow: 0 16px 40px #0002; }
      .admin-login-page h1 { margin-top: 0; }
      .admin-login-page label { display: block; margin-bottom: 8px; font-weight: 700; }
      .admin-login-page input { box-sizing: border-box; width: 100%; padding: 13px; border: 1px solid #ccd0d4; border-radius: 8px; }
      .admin-login-page button { width: 100%; margin-top: 18px; padding: 14px; border: 0; border-radius: 999px; color: white; background: #212529; font-weight: 700; cursor: pointer; }
      .admin-login-page .error { padding: 12px; color: #991b1b; background: #fef2f2; border-radius: 8px; }
      .admin-login-page .aviso { padding: 12px; color: #854d0e; background: #fefce8; border-radius: 8px; }
    </style>
  </head>
  <body>
    <main>
      <h1>Panel administrativo</h1>
      <p>Defensa Jurídica Sur</p>
      <p><a href="/admin/demo">Abrir administración de demostración (solo casos ficticios)</a></p>
      {!adminConfigurado && <p class="aviso">El acceso administrativo no está disponible por el momento.</p>}
      {error && <p class="error">No pudimos iniciar sesión. Revisa tu correo y contraseña o inténtalo más tarde.</p>}
      {Astro.url.searchParams.has('cambiada') && <p class="aviso">Contraseña guardada. Ingresa con tu nueva clave.</p>}
      <form method="post" action="/api/admin/login">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" required autocomplete="username" maxlength="254" />
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" />
        <button type="submit">Ingresar</button>
      </form>
      <p>Si olvidaste tu contraseña, solicita el restablecimiento al administrador principal.</p>
    </main>
  </body>
</html>
