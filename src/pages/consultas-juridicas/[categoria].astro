---
import Layout from "../../layouts/Layout.astro";
import { categoriasConsulta } from "../../data/seo";
import { consultarSupabase, supabaseConfigurado } from "../../lib/supabase";

const { categoria } = Astro.params;
const categoriaActual = categoriasConsulta.find((item) => item.slug === categoria);

if (!categoriaActual) {
    return new Response("Categoría no encontrada", { status: 404 });
}

interface ConsultaCategoria {
    titulo: string;
    slug: string | null;
    detalle: string;
    publicada_en: string | null;
}

let consultas: ConsultaCategoria[] = [];

if (supabaseConfigurado) {
    try {
        consultas = await consultarSupabase<ConsultaCategoria[]>(
            `consultas?select=titulo,slug,detalle,publicada_en,categorias!inner(slug)&estado=eq.publicada&categorias.slug=eq.${encodeURIComponent(categoriaActual.slug)}&order=publicada_en.desc`,
        );
    } catch (error) {
        console.error("No fue posible cargar la categoría:", error);
    }
}

const title = `${categoriaActual.nombre} | Consultas Jurídicas en Puerto Montt`;
const description = `${categoriaActual.descripcion} Revisa orientación general del equipo de Defensa Jurídica Sur en Puerto Montt.`;
const canonicalPath = `/consultas-juridicas/${categoriaActual.slug}/`;
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
    <main class="bg-gris-bg py-20">
        <div class="container mx-auto max-w-5xl px-6">
            <nav aria-label="Migas de pan" class="mb-8 text-sm text-gray-600">
                <a href="/" class="hover:text-marron">Inicio</a>
                <span aria-hidden="true"> / </span>
                <a href="/consultas-juridicas/" class="hover:text-marron">Consultas jurídicas</a>
                <span aria-hidden="true"> / </span>
                <span>{categoriaActual.nombre}</span>
            </nav>

            <header class="rounded-2xl bg-white p-8 shadow-sm md:p-12">
                <p class="font-semibold uppercase tracking-wider text-marron">
                    Centro de consultas
                </p>
                <h1 class="mt-3 text-4xl font-bold text-gray-900 md:text-5xl">
                    Consultas de {categoriaActual.nombre}
                </h1>
                <p class="mt-5 max-w-3xl text-lg leading-relaxed text-gray-700">
                    {categoriaActual.descripcion}
                </p>
            </header>

            <section class="mt-10 grid gap-6 md:grid-cols-2">
                {
                    consultas.map((consulta) => (
                        <article class="rounded-2xl bg-white p-7 shadow-sm">
                            <h2 class="text-2xl font-bold text-gray-900">
                                <a
                                    href={`/consultas-juridicas/${categoriaActual.slug}/${consulta.slug}`}
                                    class="hover:text-marron"
                                >
                                    {consulta.titulo}
                                </a>
                            </h2>
                            <p class="mt-4 line-clamp-3 leading-relaxed text-gray-600">
                                {consulta.detalle}
                            </p>
                            <a
                                href={`/consultas-juridicas/${categoriaActual.slug}/${consulta.slug}`}
                                class="mt-5 inline-block font-semibold text-marron"
                            >
                                Leer consulta y respuesta →
                            </a>
                        </article>
                    ))
                }

                {
                    consultas.length === 0 && (
                        <div class="md:col-span-2 rounded-2xl bg-white p-8 text-center text-gray-600 shadow-sm">
                            Todavía no hay consultas publicadas en esta categoría. Puedes enviar una
                            nueva desde el centro de consultas.
                        </div>
                    )
                }
            </section>

            <div class="mt-10 text-center">
                <a
                    href="/consultas-juridicas/#formulario-consulta"
                    class="inline-block rounded-full bg-black px-8 py-4 font-bold text-white"
                >
                    Enviar una consulta
                </a>
            </div>
        </div>
    </main>
</Layout>
