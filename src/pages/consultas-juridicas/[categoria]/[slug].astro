---
import Layout from "../../../layouts/Layout.astro";
import { consultarSupabase } from "../../../lib/supabase";

const { categoria, slug } = Astro.params;
interface ConsultaPublica {
  titulo: string;
  detalle: string;
  publicada_en: string | null;
  categorias: { nombre: string; slug: string } | null;
  respuestas: Array<{ contenido: string; autor: string; creada_en: string }>;
}

const resultados = await consultarSupabase<ConsultaPublica[]>(
  `consultas?select=titulo,detalle,publicada_en,categorias!inner(nombre,slug),respuestas(contenido,autor,creada_en)&slug=eq.${encodeURIComponent(slug ?? "")}&categorias.slug=eq.${encodeURIComponent(categoria ?? "")}&estado=eq.publicada&respuestas.publicada=eq.true&limit=1`,
);
const consulta = resultados[0];
if (!consulta) return new Response("Consulta no encontrada", { status: 404 });
---

<Layout>
  <main class="bg-gris-bg py-24">
    <article class="container mx-auto max-w-4xl px-4">
      <a href="/consultas-juridicas" class="font-semibold text-marron">← Volver al foro</a>
      <div class="mt-6 rounded-2xl bg-white p-8 shadow-lg md:p-12">
        <span class="rounded-full bg-yellow-100 px-3 py-1 text-sm font-semibold text-yellow-800">{consulta.categorias?.nombre}</span>
        <h1 class="mt-5 text-3xl font-bold text-gray-900 md:text-4xl">{consulta.titulo}</h1>
        <p class="mt-3 text-sm text-gray-500">{consulta.publicada_en && new Date(consulta.publicada_en).toLocaleDateString("es-CL", { dateStyle: "long" })}</p>
        <p class="mt-8 whitespace-pre-wrap text-lg leading-relaxed text-gray-700">{consulta.detalle}</p>
        {consulta.respuestas.map((respuesta) => (
          <section class="mt-10 rounded-xl border-l-4 border-marron bg-gris-bg p-6">
            <h2 class="text-xl font-bold">Respuesta profesional</h2>
            <p class="mt-4 whitespace-pre-wrap leading-relaxed text-gray-700">{respuesta.contenido}</p>
            <p class="mt-4 text-sm font-semibold text-marron">{respuesta.autor}</p>
          </section>
        ))}
      </div>
    </article>
  </main>
</Layout>

