---
import Layout from '../../layouts/Layout.astro';
import ForumDemo from '../../components/forum/ForumDemo';
import { FORUM_DEMO } from '../../lib/forum-demo';
import { demoCategories } from '../../data/forum-demo';
if (!FORUM_DEMO) return new Response('No encontrado', {status: 404});
const path = '/' + (Astro.params.ruta ?? '');
const parts = path.split('/').filter(Boolean);
if (parts[0] !== 'admin' && (parts[0] !== 'consultas-juridicas' || parts.length > 3 || (parts[1] && !demoCategories.some(c => c.slug === parts[1])))) {
  return new Response('Categoría no encontrada', {status: 404});
}
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Layout title="Foro de consultas · Demostración | Defensa Jurídica Sur" noindex={true}>
  <ForumDemo client:load path={path} />
</Layout>
