---
import Layout from "../layouts/Layout.astro";
import { serviciosSeo, type ServicioSeo } from "../data/seo";

export const prerender = true;

export function getStaticPaths() {
    return serviciosSeo.map((servicio) => ({
        params: { servicio: servicio.slug },
        props: { servicio },
    }));
}

interface Props {
    servicio: ServicioSeo;
}

const { servicio } = Astro.props;
const canonicalPath = `/${servicio.slug}/`;
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Service",
            name: servicio.nombre,
            serviceType: servicio.nombre,
            url: new URL(canonicalPath, Astro.site).toString(),
            provider: {
                "@id": "https://defensajuridicasur.cl/#organization",
            },
            areaServed: [
                { "@type": "City", name: "Puerto Montt" },
                { "@type": "AdministrativeArea", name: "Región de Los Lagos" },
            ],
            description: servicio.descripcion,
        },
        {
            "@type": "FAQPage",
            mainEntity: servicio.preguntas.map((item) => ({
                "@type": "Question",
                name: item.pregunta,
                acceptedAnswer: {
                    "@type": "Answer",
                    text: item.respuesta,
                },
            })),
        },
    ],
};
---

<Layout
    title={servicio.titulo}
    description={servicio.descripcion}
    canonicalPath={canonicalPath}
    structuredData={structuredData}
>
    <main class="bg-white">
        <section class="bg-gradient-to-br from-black via-slate-900 to-black py-24 text-white">
            <div class="container mx-auto px-6 text-center">
                <p class="mb-4 font-semibold uppercase tracking-[0.2em] text-marron">
                    Defensa Jurídica Sur
                </p>
                <h1 class="mx-auto max-w-4xl text-4xl font-bold leading-tight md:text-6xl">
                    {servicio.encabezado}
                </h1>
                <p class="mx-auto mt-7 max-w-3xl text-lg leading-relaxed text-gray-300 md:text-xl">
                    {servicio.introduccion}
                </p>
                <a
                    href="/#contacto"
                    class="mt-9 inline-block rounded-sm bg-marron px-8 py-4 font-semibold uppercase text-white transition hover:scale-105"
                >
                    Solicitar evaluación
                </a>
            </div>
        </section>

        <section class="py-20">
            <div class="container mx-auto grid gap-12 px-6 lg:grid-cols-2">
                <div>
                    <p class="font-semibold uppercase tracking-wider text-marron">
                        Cómo podemos ayudarte
                    </p>
                    <h2 class="mt-3 text-3xl font-bold text-gray-900">Situaciones que atendemos</h2>
                    <ul class="mt-7 space-y-4">
                        {
                            servicio.situaciones.map((situacion) => (
                                <li class="flex gap-3 text-lg leading-relaxed text-gray-700">
                                    <span aria-hidden="true" class="mt-1 text-marron">
                                        ✓
                                    </span>
                                    <span>{situacion}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="rounded-2xl bg-gris-bg p-8 md:p-10">
                    <p class="font-semibold uppercase tracking-wider text-marron">
                        Nuestro enfoque
                    </p>
                    <h2 class="mt-3 text-3xl font-bold text-gray-900">
                        Evaluación clara y responsable
                    </h2>
                    <p class="mt-6 text-lg leading-relaxed text-gray-700">{servicio.enfoque}</p>
                    <p class="mt-6 text-base leading-relaxed text-gray-600">
                        Atendemos en Puerto Montt y coordinamos reuniones online para personas de
                        otras comunas. La información de esta página es general y no sustituye una
                        evaluación jurídica del caso.
                    </p>
                </div>
            </div>
        </section>

        <section class="bg-gris-bg py-20">
            <div class="container mx-auto max-w-4xl px-6">
                <h2 class="text-center text-3xl font-bold text-gray-900">Preguntas frecuentes</h2>
                <div class="mt-10 space-y-5">
                    {
                        servicio.preguntas.map((item) => (
                            <article class="rounded-xl bg-white p-7 shadow-sm">
                                <h3 class="text-xl font-bold text-gray-900">{item.pregunta}</h3>
                                <p class="mt-3 leading-relaxed text-gray-700">{item.respuesta}</p>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>

        <section class="bg-black py-16 text-center text-white">
            <div class="container mx-auto px-6">
                <h2 class="text-3xl font-bold">Conversemos sobre tu situación</h2>
                <p class="mx-auto mt-4 max-w-2xl text-gray-300">
                    Agenda una reunión presencial en Puerto Montt o solicita una evaluación online.
                </p>
                <a
                    href="/#contacto"
                    class="mt-8 inline-block rounded-sm bg-marron px-8 py-4 font-semibold uppercase text-white"
                >
                    Contactar al equipo
                </a>
            </div>
        </section>
    </main>
</Layout>
