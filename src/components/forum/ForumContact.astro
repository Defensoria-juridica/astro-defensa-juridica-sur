---
import { Image } from 'astro:assets';
import { Mail, Phone, MapPin } from '@lucide/astro';
import instagramQR from '../../assets/images/instagram_isabel_qr.svg';
---

<section class="forum-contact" aria-labelledby="forum-contact-title">
  <div class="contact-card">
    <div>
      <h2 id="forum-contact-title">Contacta a nuestro equipo</h2>
      <p class="intro">Puedes comunicarte con Defensa Jurídica Sur o visitarnos en nuestra oficina.</p>
      <ul>
        <li><Phone aria-hidden="true" /><a href="tel:+56958835620">+56958835620</a></li>
        <li><Phone aria-hidden="true" /><a href="tel:+56921614436">+56921614436</a></li>
        <li><Mail aria-hidden="true" /><a href="mailto:contacto@defensajuridicasur.cl">contacto@defensajuridicasur.cl</a></li>
        <li><MapPin aria-hidden="true" /><span>O’Higgins 167, Edificio Plaza, Oficina 706, Puerto Montt</span></li>
      </ul>
    </div>
    <a class="instagram" href="https://instagram.com/defensajuridicasur" target="_blank" rel="noopener noreferrer">
      <Image src={instagramQR} alt="Código QR de Instagram de Defensa Jurídica Sur" width={180} height={180} loading="lazy" />
      <span>Síguenos en Instagram</span>
      <small>@defensajuridicasur</small>
    </a>
  </div>
</section>

<style>
  .forum-contact { background: #f7f6f3; padding: 0 20px 48px; color: #24303a; font-family: Arial, sans-serif; }
  .contact-card { max-width: 1120px; margin: 0 auto; padding: 32px; display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 32px; align-items: center; background: white; border: 1px solid #e1ded8; border-radius: 12px; }
  h2 { font-size: 26px; font-weight: 700; margin: 0 0 12px; }
  .intro { margin: 0 0 24px; line-height: 1.6; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 18px; }
  li { display: flex; align-items: flex-start; gap: 12px; line-height: 1.6; overflow-wrap: anywhere; }
  li :global(svg) { color: #876130; width: 22px; height: 22px; flex-shrink: 0; margin-top: 2px; }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; }
  a:focus-visible { outline: 2px solid #876130; outline-offset: 5px; }
  .instagram { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; color: #876130; }
  .instagram img { width: 180px; height: 180px; object-fit: contain; }
  .instagram small { font-size: 14px; }
  @media (max-width: 640px) {
    .contact-card { grid-template-columns: minmax(0, 1fr); padding: 24px 20px; }
    h2 { font-size: 23px; }
  }
</style>
