---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface TeamInterface {
    name: string;
    cargo?: string;
    position: string;
    img: ImageMetadata;
    items?: string[];
    master?: string[];
}

import imgJohn from "../assets/images/teams/john-new.webp";
import imgIsa from "../assets/images/teams/isabel-new2.webp";
import imgFer from "../assets/images/teams/fernando.webp";

import imgCristian from "../assets/images/teams/cristian-new.webp";
import imgFlavio from "../assets/images/teams/flavio.webp";
import imgTatiana from "../assets/images/teams/tatiana-new.webp";
import imgFernanda from "../assets/images/teams/fernanda.webp";

const teamAbogados: TeamInterface[] = [
    {
        name: "John Fitzgerald Ortega",
        position: "Abogado",
        img: imgJohn,
        items: ["Derecho Penal", "Derecho Administrativo", "Justicia Militar", "Derecho Corporativo"],
        master: [
            "Diplomado en Derecho Penal y Derecho Procesal Penal, por el Instituto de Estudios Judiciales",
            "Diplomado en Derecho Inmobiliario, por la Asociacion de Abogados de Chile",
            "Curso Ley 20.000, que sanciona el Tráfico ilícito de Estupefacientes y sustancias Psicotrópicas",
        ],
    },
    {
        name: "Isabel Uribe Maldonado",
        position: "Abogada",
        img: imgIsa,
        items: ["Derecho Civil", "Derecho de Familia", "Derecho Corporativo"],
        master: [
            "Diplomado en Derecho Laboral, por el Instituto de Estudios Judiciales",
            "Diplomado en Derecho Penal y Procesal Penal,  por el Instituto de Estudios Judiciales",
            "Curso de Enfermedades profesionales y accidentes Laborales, por la Universidad de Chile",
            "Instrumentos Públicos y Instrumentos Privados.",
        ],
    },
    {
        name: "Fernando Gutiérrez Jaramillo",
        position: "Abogado",
        img: imgFer,
        items: ["Derecho Laboral", "Derecho de Familia", "Deudas"],
        master: [
            "Diplomado en Derecho Laboral y Empresa",
            "Diplomado en Compliance Público y Municipal",
            "Postítulo en Recursos Procesales",
            "Diplomado en Derecho Ambiental",
        ],
    },
    {
        name: "Cristóbal Fuenzalida Palma",
