         "Diplomado en Seguridad Ciudadana por la Universidad de Chile",
         "Diplomado en Gobierno y Gestión Pública por la Universidad Alberto Hurtado",
         "Diplomado en Criminología y Nuevas Formas de Criminalidad por la Universidad Alberto Hurtado",
         "Diplomado en Derechos Humanos por la Universidad Los Lagos"
                ],
    }
];

const teamProcuradores: TeamInterface[] = [

    {
        name: "Flavio Vargas",
        cargo: "Procurador de Defensa Jurídica Sur",
        position: "Procurador",
        img: imgFlavio,
        items: ["Tramitación ante Juzgado de Policía Local", "Técnico Jurídico por el Instituto Profesional AIEP de la Universidad Andres Bello"],
    },
    {
        name: "Tatiana Uribe Maldonado",
        position: "Licenciada en trabajo social",
        img: imgTatiana,
        items: [
            "Curso de Derechos de los Niños, Niñas y Adolescentes",
            "Conceptos Básicos y Generales sobre Drogas",
            "Curso de Equidad de Género y Masculinidad",
            "Curso de Peritaje Psicosocial Forense en el Ámbito Penal",
            "Curso de Manejo de Programas Sociales y de Información Social",
            "Curso de Herramientas para el Desarrollo Sustentable.",
            "Curso de Gestión de Personas",
            "Curso de Embarazo y Salud Adolescente",
            "Curso de Prevención del Suicidio",
            "Curso de Prevención de Enfermedades y Accidentes Laborales",
            "Curso de Capacitación en Trato al Usuario",
            "Curso de Gestión en la Información en Salud",
            "Curso de Gestión Personal de Salud",
            "Curso de Prevención, Detección Temprana y Tratamiento de las Víctimas de Violencia de Género",
            "Curso de Cuidados para Adultos Mayores en el Contexto de la Atención de Salud Intra y Extra Hospitalaria",
        ],
